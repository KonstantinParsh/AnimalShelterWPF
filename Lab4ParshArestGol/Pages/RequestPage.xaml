<Page x:Class="Lab4ParshArestGol.Pages.RequestPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Lab4ParshArestGol.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="1000" d:DesignWidth="800"
      Title="RequestPage">
    <Page.Resources>
        <Style x:Key="RejectBtn" TargetType="Button">
            <Setter Property="Background" Value="#D22D2D"/>
            <Setter Property="Width" Value="400"/>
            <Setter Property="Height" Value="70"/>
            <Setter Property="Margin" Value="15 15 15 15"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
        Background="{TemplateBinding Background}">
                            <TextBlock Text="ОТКЛОНИТЬ" FontSize="14" FontFamily="Arial" FontWeight="Bold"
               TextAlignment="Center" VerticalAlignment="Center"
               HorizontalAlignment="Center" Foreground="White"
                       RenderTransformOrigin="0.5 0.5"/>
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>

                            <Border.Effect>
                                <DropShadowEffect BlurRadius="15" ShadowDepth="3"
Direction="275" Opacity="0.3"/>
                            </Border.Effect>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#AD2525"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.99" ScaleY="0.99"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ConfirmBtn" TargetType="Button">
            <Setter Property="Background" Value="#B1AF88"/>
            <Setter Property="Width" Value="400"/>
            <Setter Property="Height" Value="70"/>
            <Setter Property="Margin" Value="15 15 15 35"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
        Background="{TemplateBinding Background}">
                            <TextBlock Text="ОДОБРИТЬ" FontSize="14" FontFamily="Arial" FontWeight="Bold"
               TextAlignment="Center" VerticalAlignment="Center"
               HorizontalAlignment="Center" Foreground="White"
                       RenderTransformOrigin="0.5 0.5"/>
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>

                            <Border.Effect>
                                <DropShadowEffect BlurRadius="15" ShadowDepth="3"
Direction="275" Opacity="0.3"/>
                            </Border.Effect>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#B1AF68"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.99" ScaleY="0.99"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RequestCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Width" Value="420"/>
            <Setter Property="Height" Value="150"/>
            <Setter Property="Margin" Value="0,8"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="3" Direction="275" Opacity="0.3"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BackToMainBtnStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Width" Value="150"/>
            <Setter Property="Background" Value="#896033"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="12" SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="3" Color="Black" Opacity="0.3" Direction="270"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Background="#EEF1DE">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="3" Background="#B1AF88"/>
        <Border Grid.Row="2" Grid.ColumnSpan="3" Background="#D8BF97"/>

        <Border Grid.Column="1" Grid.Row="0" BorderThickness="2 0 2 0" BorderBrush="White" Width="400">
            <StackPanel Margin="10" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="ЗАЯВКИ НА РАССМОТРЕНИИ" FontSize="20" FontWeight="Bold" Foreground="White" FontFamily="Arial"/>
            </StackPanel>
        </Border>

        <Button Grid.Column="0" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="15" x:Name="BtnBack" Click="BtnBack_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Image x:Name="BtnImg" Source="/Images/BackwardBtn.png" Width="50" Height="50"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BtnImg" Property="Opacity" Value="0.8"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
            <Button.Effect>
                <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.5"/>
            </Button.Effect>
        </Button>

        <Button Grid.Column="2" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="15" x:Name="BtnNwxt" Click="BtnNwxt_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Image x:Name="BtnImg" Source="/Images/ForwarBtn.png" Width="50" Height="50"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BtnImg" Property="Opacity" Value="0.8"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
            <Button.Effect>
                <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.5"/>
            </Button.Effect>
        </Button>

        <ItemsControl x:Name="RequestsControl" Grid.Row="1" Grid.Column="1" Margin="0,30,0,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource RequestCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="280"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="15,0">
                                <TextBlock Text="{Binding ClientName, StringFormat='КЛИЕНТ: {0}'}" FontWeight="Bold" FontSize="15" FontFamily="Arial" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding UserId, StringFormat='ID КЛИЕНТА: {0}'}" FontSize="11" Foreground="Gray" FontFamily="Arial"/>

                                <Border BorderBrush="#EEF1DE" BorderThickness="0,1,0,0" Margin="0,6"/>

                                <TextBlock Text="{Binding AnimalName, StringFormat='Животное: {0}'}" FontWeight="Bold" FontSize="15" FontFamily="Arial" Foreground="#896033"/>
                                <TextBlock Text="{Binding AnimalType, StringFormat='Вид: {0}'}" FontSize="12" FontFamily="Arial"/>
                                <TextBlock Text="{Binding AnimalBreed, StringFormat='Порода: {0}'}" FontSize="12" FontFamily="Arial"/>
                                <TextBlock Text="{Binding RequestDate, StringFormat='Дата подачи: {0}'}" FontSize="12" FontFamily="Arial"/>
                                <TextBlock Text="{Binding RequestType, StringFormat='Тип заявки: {0}'}" FontSize="12" FontFamily="Arial"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Button Style="{StaticResource ConfirmBtn}" Click="Button_Click"  Width="100" Height="35" Margin="0,0,0,10" Background="#B1AF88" Foreground="White" FontWeight="Bold" FontSize="12">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="8"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                                <Button Style="{StaticResource RejectBtn}" x:Name="RejectBtn" Click="RejectBtn_Click"  Width="100" Height="35" Background="#E6A1A1" Foreground="White" FontWeight="Bold" FontSize="12">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="8"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button x:Name="BckToMnBtn" Grid.Column="1" Grid.Row="2" Style="{StaticResource BackToMainBtnStyle}" Content="НАЗАД" Click="BackBtn_Click"/>
    </Grid>
</Page>
