<Page x:Class="Lab4ParshArestGol.Pages.ApplicationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Lab4ParshArestGol.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="1000" d:DesignWidth="800"
      Title="ApplicationPage">
    <Page.Resources>
        <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
            <Grid>
                <Border x:Name="templateRoot" 
        Background="White" 
        CornerRadius="20" 
        SnapsToDevicePixels="true"
                        BorderThickness="3" BorderBrush="#896033">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" ShadowDepth="3"
Direction="275" Opacity="0.3"/>
                    </Border.Effect>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="50" />
                    </Grid.ColumnDefinitions>
                    <Path x:Name="arrow" 
          Grid.Column="1" 
          HorizontalAlignment="Center" 
          VerticalAlignment="Center"
          Data="M 0 0 L 7 8 L 14 0 Z" 
          Fill="#D8BF97" 
          Stretch="None"/>
                </Grid>
            </Grid>
        </ControlTemplate>

        <Style x:Key="ComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#D8BF97"/>
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="Width" Value="200"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Padding" Value="20 0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0 30 0 0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="templateRoot" SnapsToDevicePixels="true">
                            <ToggleButton x:Name="toggleButton" 
                          Template="{StaticResource ComboBoxToggleButton}" 
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                          ClickMode="Press"/>

                            <ContentPresenter x:Name="contentPresenter" 
                              Content="{TemplateBinding SelectionBoxItem}"
                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              Margin="{TemplateBinding Padding}"
                              IsHitTestVisible="false"
                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>

                            <Popup x:Name="PART_Popup" AllowsTransparency="true" Grid.ColumnSpan="2" 
                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}" 
                   Placement="Bottom" PopupAnimation="Slide">
                                <Border x:Name="dropDownBorder" 
                        Background="White" 
                        CornerRadius="10"
                        BorderBrush="#D8BF97" 
                        BorderThickness="1"
                        Margin="0 5 0 0"
                        MinWidth="{Binding ActualWidth, ElementName=templateRoot}" 
                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer x:Name="DropDownScrollViewer">
                                        <ItemsPresenter x:Name="ItemsPresenter" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SumbitButton" TargetType="Button">
            <Setter Property="Background" Value="#B1AF88"/>
            <Setter Property="Width" Value="300"/>
            <Setter Property="Height" Value="70"/>
            <Setter Property="Margin" Value="15 15 15 35"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
        Background="{TemplateBinding Background}">
                            <TextBlock Text="ОТПРАВИТЬ АНКЕТУ" FontSize="24" FontFamily="Arial" FontWeight="Bold"
               TextAlignment="Center" VerticalAlignment="Center"
               HorizontalAlignment="Center" Foreground="White"
                       RenderTransformOrigin="0.5 0.5"/>
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>

                            <Border.Effect>
                                <DropShadowEffect BlurRadius="15" ShadowDepth="3"
Direction="275" Opacity="0.3"/>
                            </Border.Effect>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#B1AF68"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.99" ScaleY="0.99"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#D8BF97"/>
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Width" Value="200"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="TextAlignment" Value="Left"/>
            <Setter Property="Padding" Value="15 5"/>
            <Setter Property="Margin" Value="0 30 0 0"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="BorderBrush" Value="#896033"/>
        </Style>
        <Style x:Key="BackToMainBtnStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Width" Value="150"/>
            <Setter Property="Background" Value="#896033"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
    Background="{TemplateBinding Background}" 
    CornerRadius="12" 
    SnapsToDevicePixels="True"
            RenderTransformOrigin="0.5 0.5">

                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="3" Color="Black" Opacity="0.3" Direction="270"/>
                            </Border.Effect>

                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#A67B4D"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#6D4A28"/>
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.99" ScaleY="0.99"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>
    <Grid Background="#EEF1DE">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="60"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="60"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="60"></RowDefinition>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="3" Background="#B1AF88"/>
        <Border Grid.Row="2" Grid.ColumnSpan="3" Background="#D8BF97"/>

        <Border Grid.Column="1" Grid.Row="0" 
        BorderThickness="2 0 2 0" BorderBrush="White"
        Width="400">
            <StackPanel Margin="10" VerticalAlignment="Center"
                HorizontalAlignment="Center">
                <TextBlock Text="ДОБАВЛЕНИЕ ЖИВОТНОГО" FontSize="20"
                   FontWeight="Bold" Foreground="White" FontFamily="Arial"/>
            </StackPanel>
        </Border>

        <Button x:Name="BckToMnBtn"
        Grid.Column="1" Grid.Row="2"
        Style="{StaticResource BackToMainBtnStyle}"
        Content="НАЗАД"
        Click="BckToMnBtn_Click"/>

        <Border Grid.Column="1" Grid.Row="1"
                Width="600" Height="800" Background="White" BorderThickness="4"
                CornerRadius="60" BorderBrush="#977C5F">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="3" Color="Black" Opacity="0.3" Direction="270"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                </Grid.RowDefinitions>

                <Border Grid.ColumnSpan="2" Grid.Row="0">
                    <TextBlock Grid.Row="0" 
       Text="АНКЕТА" FontSize="32"
       FontFamily="Arial Black" Foreground="#896033"
       VerticalAlignment="Top" HorizontalAlignment="Center" Margin="15">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="3" Direction="300" ShadowDepth="1" Opacity="0.5"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </Border>

                <Border Grid.Column="0" Grid.Row="0">
                    <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                        <TextBox Style="{StaticResource TextBoxStyle}" Text="ИМЯ*" x:Name="NameField">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="20"/>
                                </Style>
                            </TextBox.Resources>
                            <TextBox.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="3" Color="Black" Opacity="0.3" Direction="270"/>
                            </TextBox.Effect>
                        </TextBox>
                        <TextBox Style="{StaticResource TextBoxStyle}" Text="ВИД*" x:Name="SpeciesField">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="20"/>
                                </Style>
                            </TextBox.Resources>
                            <TextBox.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="3" Color="Black" Opacity="0.3" Direction="270"/>
                            </TextBox.Effect>
                        </TextBox>
                        <ComboBox Style="{StaticResource ComboBoxStyle}" x:Name="GenderField">
                            <ComboBoxItem Content="ПОЛ*" IsEnabled="False" IsSelected="True" Visibility="Collapsed"/>
                            <ComboBoxItem Content="МУЖ"/>
                            <ComboBoxItem Content="ЖЕН"/>
                        </ComboBox>
                        <TextBox Style="{StaticResource TextBoxStyle}" x:Name="BreedField" Text="ПОРОДА*">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="20"/>
                                </Style>
                            </TextBox.Resources>
                            <TextBox.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="3" Color="Black" Opacity="0.3" Direction="270"/>
                            </TextBox.Effect>
                        </TextBox>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Grid.Row="0">
                    <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                        <TextBox Style="{StaticResource TextBoxStyle}" x:Name="AgeMonthsField" Text="ВОЗРАСТ*">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="20"/>
                                </Style>
                            </TextBox.Resources>
                            <TextBox.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="3" Color="Black" Opacity="0.3" Direction="270"/>
                            </TextBox.Effect>
                        </TextBox>
                        <TextBox Style="{StaticResource TextBoxStyle}" x:Name="WeightField" Text="ВЕС*">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="20"/>
                                </Style>
                            </TextBox.Resources>
                            <TextBox.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="3" Color="Black" Opacity="0.3" Direction="270"/>
                            </TextBox.Effect>
                        </TextBox>
                        <TextBox Style="{StaticResource TextBoxStyle}" x:Name="VaccinationsField" Text="ВАКЦ-ИИ*">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="20"/>
                                </Style>
                            </TextBox.Resources>
                            <TextBox.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="3" Color="Black" Opacity="0.3" Direction="270"/>
                            </TextBox.Effect>
                        </TextBox>
                        <TextBox Style="{StaticResource TextBoxStyle}" x:Name="ColorField" Text="ЦВЕТ*">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="20"/>
                                </Style>
                            </TextBox.Resources>
                            <TextBox.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="3" Color="Black" Opacity="0.3" Direction="270"/>
                            </TextBox.Effect>
                        </TextBox>
                    </StackPanel>
                </Border>
                <Border Grid.ColumnSpan="2" Grid.Row="1">
                    <StackPanel Orientation="Vertical">
                        <TextBox Style="{StaticResource TextBoxStyle}" Margin="0 0 0 30"
                                 Width="500" x:Name="PhotoField" Text="ВЫБЕРИТЕ ФОТО*" MouseDoubleClick="PhotoField_MouseDoubleClick">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="20"/>
                                </Style>
                            </TextBox.Resources>
                            <TextBox.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="3" Color="Black" Opacity="0.3" Direction="270"/>
                            </TextBox.Effect>
                        </TextBox>
                        <TextBox Style="{StaticResource TextBoxStyle}" Margin="0" Width="500" Height="200"
                                 MaxLength="100" x:Name="DescriptionField" Text="ОПИСАНИЕ* (не более 100 симв.)"
                                 VerticalContentAlignment="Top" Padding="15" TextWrapping="Wrap">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="30"/>
                                </Style>
                            </TextBox.Resources>
                            <TextBox.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="3" Color="Black" Opacity="0.3" Direction="270"/>
                            </TextBox.Effect>
                        </TextBox>

                        <Button x:Name="SumbitBtn" Style="{StaticResource SumbitButton}" Click="SumbitBtn_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="20"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>
