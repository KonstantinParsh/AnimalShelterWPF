<Page x:Class="Lab4ParshArestGol.Pages.AnimalInfo"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Lab4ParshArestGol.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="1000" d:DesignWidth="800"
      Title="AnimalInfo">
    <Page.Resources>
        <Style x:Key="TakeHomeBtn" TargetType="Button">
            <Setter Property="Height" Value="60"/>
            <Setter Property="Width" Value="220"/>
            <Setter Property="Background" Value="#B1AF88"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0 15"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                    Background="{TemplateBinding Background}" 
                    CornerRadius="12" 
                    SnapsToDevicePixels="True"
                    RenderTransformOrigin="0.5 0.5">

                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="3" Color="Black" Opacity="0.3" Direction="270"/>
                            </Border.Effect>

                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#7F7C53"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#B1AF88"/>
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.99" ScaleY="0.99"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="BackToMainBtnStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Width" Value="150"/>
            <Setter Property="Background" Value="#896033"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="12" 
                                SnapsToDevicePixels="True"
                                RenderTransformOrigin="0.5 0.5">

                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="3" Color="Black" Opacity="0.3" Direction="270"/>
                            </Border.Effect>

                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#A67B4D"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#6D4A28"/>
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.99" ScaleY="0.99"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>
    <Grid Background="#EEF1DE">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="60"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="60"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="60"></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="3" Background="#B1AF88"/>
        <Border Grid.Row="2" Grid.ColumnSpan="3" Background="#D8BF97"/>

        <Border Grid.Column="1" Grid.Row="0" 
                BorderThickness="2 0 2 0" BorderBrush="White"
                Width="400">
            <StackPanel Margin="10" VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                <TextBlock Text="{Binding Name}" FontSize="20"
                           FontWeight="Bold" Foreground="White" FontFamily="Arial"/>
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Grid.Row="1">
            <StackPanel Margin="10" HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Border BorderThickness="0"
                        Width="600" Height="800"
                        CornerRadius="60"
                        Background="White">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" ShadowDepth="3"
                                          Direction="275" Opacity="0.3"/>
                    </Border.Effect>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Vertical">
                            <Border CornerRadius="25 25 25 25"
                                    Height="250" Width="240"
                                    VerticalAlignment="Top"
                                    Margin="25">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding PhotoPath}" Stretch="UniformToFill"
                                                AlignmentX="Center" AlignmentY="Center"/>
                                </Border.Background>
                            </Border>

                            <Button x:Name="TakeHmBt" Content="ЗАБРАТЬ ДОМОЙ!"
                                    Style="{StaticResource TakeHomeBtn}"
                                    Click="TakeHmBt_Click"/>

                            <TextBlock x:Name="Request" Text="Обрабатывается..."
                                       TextAlignment="Center" Visibility="Hidden"
                                       FontFamily="Arial" FontSize="18"
                                       Foreground="#3F372C"/>
                        </StackPanel>

                        <Border Grid.Column="1" Margin="0 25 25 25">
                            <StackPanel Orientation="Vertical" Margin="0 15">
                                <TextBlock Text="ОПИСАНИЕ:" FontSize="24"
                                           FontWeight="Bold" FontFamily="Arial"
                                           Margin="0 15"/>
                                <TextBlock Text="{Binding Description}" FontSize="22"
                                           FontFamily="Arial" TextWrapping="Wrap"
                                           Margin="0 15"/>
                                <TextBlock Text="{Binding Species, StringFormat='ВИД: {0}'}"
                                           FontSize="24" FontWeight="Bold" TextWrapping="Wrap"
                                           FontFamily="Arial" Margin="0 15"/>
                                <TextBlock FontSize="24" FontWeight="Bold" FontFamily="Arial" Margin="0 15">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="ПОЛ: не указан"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Gender}" Value="0">
                                                    <Setter Property="Text" Value="ПОЛ: ЖЕН"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Gender}" Value="1">
                                                    <Setter Property="Text" Value="ПОЛ: МУЖ"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding Breed, StringFormat='ПОРОДА: {0}'}"
                                           FontSize="24" FontWeight="Bold" TextWrapping="Wrap"
                                           FontFamily="Arial" Margin="0 15"/>
                                <TextBlock Text="{Binding Color, StringFormat='ОКРАС: {0}'}"
                                           FontSize="24" FontWeight="Bold" TextWrapping="Wrap"
                                           FontFamily="Arial" Margin="0 15"/>
                                <TextBlock Text="{Binding AgeMonths, StringFormat='ВОЗРАСТ (В месяцах): {0}'}"
                                           FontSize="24" FontWeight="Bold" TextWrapping="Wrap"
                                           FontFamily="Arial" Margin="0 15"/>
                                <TextBlock Text="{Binding Weight, StringFormat='ВЕС (в кг): {0}'}"
                                           FontSize="24" FontWeight="Bold" TextWrapping="Wrap"
                                           FontFamily="Arial" Margin="0 15"/>
                                <TextBlock Text="{Binding Vaccinations,StringFormat='ВАКЦИНАЦИИ: {0}'}"
                                           FontSize="24" FontWeight="Bold" TextWrapping="Wrap"
                                           FontFamily="Arial" Margin="0 15"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <Button x:Name="BackBtn"
                Grid.Column="1" Grid.Row="2"
                Style="{StaticResource BackToMainBtnStyle}"
                Content="НАЗАД"
                Click="BackBtn_Click"/>
    </Grid>
</Page>
