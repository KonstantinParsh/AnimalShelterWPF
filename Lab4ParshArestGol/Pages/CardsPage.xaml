<Page x:Class="Lab4ParshArestGol.Pages.CardsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Lab4ParshArestGol.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="1000" d:DesignWidth="800"
      Title="CardsPage">
    <Page.Resources>
        <Style x:Key="AnimalCardButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="20" BorderThickness="0"
                                Margin="10" Width="400" Height="150"
                                RenderTransformOrigin="0.5 0.5">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="15" ShadowDepth="3"
                                                  Direction="275" Opacity="0.5"/>
                            </Border.Effect>

                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>

                            <ContentPresenter/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F2F2F2"/>
                            </Trigger>
                            <Trigger Property="Button.IsPressed" Value="True">
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.99" ScaleY="0.99"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>
    <Grid Background="#EEF1DE">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="Auto"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="60"></RowDefinition>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="3" Background="#B1AF88"/>
        <Border Grid.Row="2" Grid.ColumnSpan="3" Background="#D8BF97"/>

        <Border Grid.Column="1" Grid.Row="0" 
                BorderThickness="2 0 2 0" BorderBrush="White"
                Width="400">
            <StackPanel Margin="10" VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                <TextBlock Text="ЖИТЕЛИ НАШЕГО ПИТОМНИКА" FontSize="22"
                           FontWeight="Bold" Foreground="White" FontFamily="Candara"/>
            </StackPanel>
        </Border>

        <Button Grid.Column="0" Grid.Row="1"
                VerticalAlignment="Top" HorizontalAlignment="Left"
                Margin="15"
                x:Name="BtnBack"
                Click="BtnBack_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Image x:Name="BtnImg"
                   Source="/Images/BackwardBtn.png"
                   Width="50" Height="50"
                   Opacity="1"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BtnImg" Property="Opacity" Value="0.8"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
            <Button.Effect>
                <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.5"/>
            </Button.Effect>
        </Button>
        <Button Grid.Column="2" Grid.Row="1"
                VerticalAlignment="Top" HorizontalAlignment="Right"
                Margin="15"
                x:Name="BtnNwxt"
                Click="BtnNwxt_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Image x:Name="BtnImg"
           Source="/Images/ForwarBtn.png"
           Width="50" Height="50"
           Opacity="1"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BtnImg" Property="Opacity" Value="0.8"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
            <Button.Effect>
                <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.5"/>
            </Button.Effect>
        </Button>

        <ItemsControl x:Name="AnimalsControl"
                      Grid.Row="1" Grid.Column="1">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Style="{StaticResource AnimalCardButtonStyle}"
                            Click="Button_Click">
                        <Grid Width="380">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"></ColumnDefinition>
                                <ColumnDefinition Width="*"></ColumnDefinition>
                            </Grid.ColumnDefinitions>

                            <Border CornerRadius="15" Margin="5" Background="#F0F0F0">
                                <Image Source="{Binding PhotoPath}" Stretch="UniformToFill"/>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10 0">
                                <TextBlock Text="{Binding Name, StringFormat='ИМЯ: {0}'}"
                                           FontWeight="Bold" FontSize="16"/>
                                <TextBlock Text="ОПИСАНИЕ:" FontSize="10" Foreground="Gray" Margin="0 5 0 0"/>
                                <TextBlock Text="{Binding Description}"
                                           TextWrapping="Wrap" FontSize="11"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Page>
